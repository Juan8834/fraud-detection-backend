{
  "compilerOptions": {
    /* Target modern Node.js */
    "target": "ES2020",
    "module": "CommonJS",
    "outDir": "./dist",

    /* Strictness */
    "strict": true,
    "noImplicitAny": false,

    /* Module interop */
    "esModuleInterop": true,
    "skipLibCheck": true,

    /* Node support */
    "moduleResolution": "node",
    "resolveJsonModule": true,
    "types": ["node"],

    /* Source maps for easier debugging (optional) */
    "sourceMap": true
  },

  /* Only compile source code */
  "include": ["src/**/*.ts"],

  /* Ignore these folders */
  "exclude": ["node_modules", "dist", "prisma/migrations", "prisma/schema.prisma"]
}
