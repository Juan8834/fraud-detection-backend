{
  "compilerOptions": {
    "target": "ES2020",
    "module": "CommonJS",
    "outDir": "./dist",
    "rootDir": ".",

    /* Strictness */
    "strict": true,
    "noImplicitAny": false,

    /* Interop */
    "esModuleInterop": true,

    /* Build performance */
    "skipLibCheck": true,

    /* Node */
    "moduleResolution": "node",
    "resolveJsonModule": true,
    "types": ["node"]
  },
  "include": ["src", "prisma/**/*.ts"]
}
