{
  "compilerOptions": {
    "target": "ES2020",
    "module": "CommonJS",
    "outDir": "./dist",

    /* Strictness */
    "strict": true,
    "noImplicitAny": false,

    /* Interop */
    "esModuleInterop": true,

    /* Build performance */
    "skipLibCheck": true,

    /* Node support */
    "moduleResolution": "node",
    "resolveJsonModule": true,
    "types": ["node"]
  },
  "include": ["src/**/*.ts", "prisma/**/*.ts"],
  "exclude": ["node_modules", "dist"]
}
