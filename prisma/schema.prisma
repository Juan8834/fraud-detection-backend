datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

model Store {
  id        Int      @id @default(autoincrement())
  name      String
  location  String?
  createdAt DateTime @default(now())

  employees       Employee[]
  posTerminals    POS[]
  transactions    Transaction[]
  exceptionEvents ExceptionEvent[]
  cctvevents      CCTVEvent[]
}

model Employee {
  id                           Int                           @id @default(autoincrement())
  firstName                    String
  lastName                     String
  role                         String
  email                        String                        @unique
  storeId                      Int?                          // 🔥 Temporarily optional
  store                        Store?                        @relation(fields: [storeId], references: [id])
  suspicionScore               Int                           @default(0)
  flaggedCount                 Int                           @default(0)
  isFlagged                    Boolean                       @default(false)
  shifts                       Shift[]
  transactions                 Transaction[]
  createdAt                    DateTime                      @default(now())
  exceptionEvents              ExceptionEvent[]
  investigationCases           InvestigationCase[]
  investigationCaseOnEmployees InvestigationCaseOnEmployee[]
}

model Customer {
  id              Int      @id @default(autoincrement())
  name            String
  email           String?
  phone           String?
  deviceId        String?
  riskLevel       Int      @default(0)
  historicalFlags Int      @default(0)
  createdAt       DateTime @default(now())

  transactions                 Transaction[]
  exceptionEvents              ExceptionEvent[]
  investigationCaseOnCustomers InvestigationCaseOnCustomer[]
}

model Item {
  id         Int      @id @default(autoincrement())
  sku        String?  @unique   // 🔥 Temporarily optional
  name       String
  category   String?
  price      Float
  stock      Int
  shrinkRisk Int      @default(0)
  createdAt  DateTime @default(now())

  txItems TransactionItem[]
}

model Transaction {
  id              Int             @id @default(autoincrement())
  storeId         Int?            // 🔥 Temporarily optional
  store           Store?          @relation(fields: [storeId], references: [id])
  employeeId      Int
  employee        Employee        @relation(fields: [employeeId], references: [id])
  customerId      Int?
  customer        Customer?       @relation(fields: [customerId], references: [id])
  totalAmount     Float
  transactionType TransactionType?  // 🔥 Temporarily optional
  createdAt       DateTime        @default(now())
  note            String?

  fraudType        String?
  riskScore        Int?
  fraudExplanation String?

  txItems         TransactionItem[]
  exceptionEvents ExceptionEvent[]
  cases           InvestigationCaseOnTransaction[]

  // ======================
  // ✅ NEW FIELDS FOR CASE MANAGEMENT
  caseStatus String   @default("OPEN")                 // stores current status
  caseNotes  Json     @default("[]")                   // stores array of notes as JSON
  lastUpdated DateTime @default(now()) @updatedAt

}


model TransactionItem {
  id            Int         @id @default(autoincrement())
  transaction   Transaction @relation(fields: [transactionId], references: [id])
  transactionId Int
  item          Item        @relation(fields: [itemId], references: [id])
  itemId        Int
  quantity      Int
  unitPrice     Float
}

model ExceptionEvent {
  id            Int           @id @default(autoincrement())
  storeId       Int
  store         Store         @relation(fields: [storeId], references: [id])
  transactionId Int?
  transaction   Transaction?  @relation(fields: [transactionId], references: [id])
  employeeId    Int?
  employee      Employee?     @relation(fields: [employeeId], references: [id])
  customerId    Int?
  customer      Customer?     @relation(fields: [customerId], references: [id])
  eventType     ExceptionType
  severity      Severity      @default(MEDIUM)
  description   String
  createdAt     DateTime      @default(now())
}

model InvestigationCase {
  id           Int        @id @default(autoincrement())
  title        String
  description  String?
  status       CaseStatus @default(OPEN)
  assignedToId Int?
  assignedTo   Employee?  @relation(fields: [assignedToId], references: [id])
  openedAt     DateTime   @default(now())
  closedAt     DateTime?

  transactions InvestigationCaseOnTransaction[]
  employees    InvestigationCaseOnEmployee[]
  customers    InvestigationCaseOnCustomer[]

  notes Json?
}

model InvestigationCaseOnTransaction {
  id            Int               @id @default(autoincrement())
  case          InvestigationCase @relation(fields: [caseId], references: [id])
  caseId        Int
  transaction   Transaction       @relation(fields: [transactionId], references: [id])
  transactionId Int
}

model InvestigationCaseOnEmployee {
  id         Int               @id @default(autoincrement())
  caseId     Int
  case       InvestigationCase @relation(fields: [caseId], references: [id])
  employeeId Int
  employee   Employee          @relation(fields: [employeeId], references: [id])
}

model InvestigationCaseOnCustomer {
  id         Int               @id @default(autoincrement())
  caseId     Int
  case       InvestigationCase @relation(fields: [caseId], references: [id])
  customerId Int
  customer   Customer          @relation(fields: [customerId], references: [id])
}

model Shift {
  id         Int       @id @default(autoincrement())
  employee   Employee  @relation(fields: [employeeId], references: [id])
  employeeId Int
  start      DateTime
  end        DateTime?
  createdAt  DateTime  @default(now())
}

model POS {
  id         Int      @id @default(autoincrement())
  storeId    Int
  store      Store    @relation(fields: [storeId], references: [id])
  terminalId String
  location   String?
  createdAt  DateTime @default(now())
}

model CCTVEvent {
  id          Int      @id @default(autoincrement())
  storeId     Int
  store       Store    @relation(fields: [storeId], references: [id])
  timestamp   DateTime
  clipPath    String?
  description String?
  createdAt   DateTime @default(now())
}

enum TransactionType {
  SALE
  REFUND
  EXCHANGE
  VOID
  NO_SALE
  FRAUD   // ✅ Added
}

enum ExceptionType {
  HIGH_VALUE_SALE
  MULTIPLE_REFUNDS
  NO_SALE_DRAWER
  AFTER_HOURS
  IMPOSSIBLE_TRAVEL
  SUSPICIOUS_DEVICE
  EMPLOYEE_FLAG
  MANUAL_FLAG
  OTHER
}

enum Severity {
  LOW
  MEDIUM
  HIGH
}

enum CaseStatus {
  OPEN
  PENDING
  CLOSED
}
